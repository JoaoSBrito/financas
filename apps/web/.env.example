# Copie para .env.local e preencha com os dados do projeto no Supabase
# (Project Settings → API). A chave pública pode aparecer como "publishable" ou "anon".
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-chave-publica

# Somente no servidor (Vercel → Environment Variables, sem o prefixo NEXT_PUBLIC_):
# chave secreta do Supabase (Project Settings → API Keys → secret / service_role)
SUPABASE_SECRET_KEY=sb_secret_...
# Texto aleatório longo; a Vercel envia no cabeçalho da tarefa diária
CRON_SECRET=troque-por-um-texto-aleatorio
